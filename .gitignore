# Ignore node_modules
node_modules/
frontend/node_modules/

# Ignore Angular build output
frontend/dist/
frontend/.angular/

# Ignore IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Explicitly ensure core folders are tracked
!ui-ux/
!database/
!frontend/
!backend/

# Ignore Python caches & compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.eggs/
*.egg-info/

# Ignore Python virtual environments
.venv/
venv/
env/
ENV/

# Ignore database secrets, credentials and local DBs
.env
*.db
*.sqlite
*.sqlite3
